{
  "openapi": "3.0.0",
  "info": {
    "title": "Data API",
    "version": "1.0.0",
    "description": "API for managing data."
  },
  "servers": [
    {
      "url": "http://localhost:9088",
      "description": "Local server"
    }
  ],
  "paths": {
    "/Data/{SIMXXXX}": {
      "get": {
        "summary": "Retrieve data",
        "description": "Retrieves data based on the specified parameters.",
        "parameters": [
          {
            "name": "SIMXXXX",
            "in": "path",
            "required": true,
            "description": "Data ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Data type",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["number", "string", "vector", "matrix"]
            }
          },
          {
            "name": "row",
            "in": "query",
            "description": "Number of rows (applicable only for 'vector' and 'matrix' types)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "col",
            "in": "query",
            "description": "Number of columns (applicable only for 'vector' and 'matrix' types)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "row": {
                      "type": "integer"
                    },
                    "col": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update data",
        "description": "Updates data for the given ID based on the provided body.",
        "parameters": [
          {
            "name": "SIMXXXX",
            "in": "path",
            "required": true,
            "description": "Data ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "description": "Data type",
                    "type": "string",
                    "enum": ["number", "string", "vector", "matrix"]
                  },
                  "row": {
                    "description": "Number of rows (applicable only for 'vector' and 'matrix' types)",
                    "type": "integer",
                    "required": false
                  },
                  "col": {
                    "description": "Number of columns (applicable only for 'vector' and 'matrix' types)",
                    "type": "integer",
                    "required": false
                  },
                  "data": {
                    "description": "Actual data content",
                    "type": "string"
                  }
                },
                "required": ["type", "data"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data updated successfully"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  }
}
