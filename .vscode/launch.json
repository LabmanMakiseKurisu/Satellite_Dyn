{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Satellite_Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/Satellite",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/release",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "为 gdb 启用美化打印",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          }
      ],
      "preLaunchTask": "build",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
