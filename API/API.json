{
  "swagger": "2.0",
  "info": {
    "description": "API for managing simulation parameters and reading data from InfluxDB. Note: Use port 8081 for simulation-related operations and port 8082 for database operations.",
    "version": "1.0.0",
    "title": "Simulation and Data API"
  },
  "host": "localhost",
  "basePath": "/api",
  "schemes": [
    "http"
  ],
  "paths": {
    "/simulation/parameters": {
      "put": {
        "tags": [
          "Simulation"
        ],
        "summary": "Update a simulation parameter (Use port 8081)",
        "description": "This operation should be accessed through port 8081.",
        "operationId": "updateSimulationParameter",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Parameter name and value to update",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ParameterUpdate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parameter updated successfully"
          }
        }
      }
    },
    "/data/SIM/{field}": {
      "get": {
        "tags": [
          "InfluxDB Data"
        ],
        "summary": "Get data for a specific field from InfluxDB (Use port 8082)",
        "description": "This operation should be accessed through port 8082.",
        "operationId": "getDataFromInfluxDB",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "field",
            "in": "path",
            "description": "Field name to retrieve data for",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "schema": {
              "$ref": "#/definitions/DataResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ParameterUpdate": {
      "type": "object",
      "properties": {
        "parameterName": {
          "type": "string"
        },
        "parameterValue": {
          "type": "string"
        }
      },
      "example": {
        "parameterName": "someParameter",
        "parameterValue": "newValue"
      }
    },
    "DataResponse": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "example": {
        "field": "SIM0901",
        "value": 100,
        "timestamp": "2024-04-10T12:00:00Z"
      }
    }
  }
}
